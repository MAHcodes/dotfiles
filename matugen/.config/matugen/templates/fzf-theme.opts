# Generated by matugen from the current Dux Shell (DMS) theme.
# Do not edit: changes are overwritten on every theme update.
#
# Read by fzf through FZF_DEFAULT_OPTS_FILE on every invocation, so running
# shells pick up theme changes without being restarted.
--color=fg:{{ colors.on_surface.default.hex }},bg:{{ colors.background.default.hex }},hl:{{ colors.primary.default.hex }},fg+:{{ colors.on_surface.default.hex }},bg+:{{ colors.surface_container_high.default.hex }},hl+:{{ colors.primary.default.hex }},info:{{ colors.tertiary.default.hex }},prompt:{{ colors.primary.default.hex }},pointer:{{ colors.secondary.default.hex }},marker:{{ colors.secondary.default.hex }},spinner:{{ colors.tertiary.default.hex }},header:{{ colors.primary.default.hex }},border:{{ colors.outline.default.hex }},label:{{ colors.on_surface_variant.default.hex }},query:{{ colors.on_surface.default.hex }},gutter:{{ colors.background.default.hex }},separator:{{ colors.outline_variant.default.hex }},scrollbar:{{ colors.outline.default.hex }},preview-bg:{{ colors.surface_container.default.hex }},preview-fg:{{ colors.on_surface.default.hex }},disabled:{{ colors.on_surface_variant.default.hex }}
