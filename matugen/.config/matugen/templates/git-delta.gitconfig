# Generated by matugen from the current Dux Shell (DMS) theme.
# Do not edit: changes are overwritten on every theme update.
#
# Style values are double-quoted because `#` starts a comment in gitconfig;
# without quotes git would silently truncate every colour value.
[delta "dank"]
<* if {{ is_dark_mode }} *>
	dark = true
<* else *>
	light = true
<* endif *>
	commit-decoration-style = "box ul"
	commit-style = "{{ colors.primary.default.hex }} bold"
	file-decoration-style = "{{ colors.outline.default.hex }}"
	file-style = "{{ colors.on_surface.default.hex }}"
	hunk-header-decoration-style = "box ul"
	hunk-header-file-style = "bold {{ colors.primary.default.hex }}"
	hunk-header-line-number-style = "{{ colors.on_surface_variant.default.hex }}"
	hunk-header-style = "file line-number syntax"
	line-numbers-left-style = "{{ colors.on_surface_variant.default.hex }}"
	line-numbers-minus-style = "bold {{ colors.error.default.hex }}"
	line-numbers-plus-style = "bold {{ dank16term.color2.default.hex }}"
	line-numbers-right-style = "{{ colors.on_surface_variant.default.hex }}"
	line-numbers-zero-style = "{{ colors.on_surface_variant.default.hex }}"
	minus-emph-style = "bold syntax {{ colors.error_container.default.hex }}"
	minus-style = "syntax {{ colors.surface_container_high.default.hex }}"
	plus-emph-style = "bold syntax {{ colors.surface_container_highest.default.hex }}"
	plus-style = "syntax {{ colors.surface_container_high.default.hex }}"
	whitespace-error-style = "{{ colors.error.default.hex }} reverse"
	syntax-theme = "ansi"
