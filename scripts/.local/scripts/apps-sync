#!/bin/sh

# Auto-commit changes to the stow-linked applications folder.
# ~/.local/share/applications is a symlink into the repo, so .desktop
# files installed by apps land directly in ~/dotfiles/applications.

DOTFILES="$HOME/dotfiles"

# let bursts of writes from installers settle
sleep 5

exec 9>"${XDG_RUNTIME_DIR:-/tmp}/apps-sync.lock" || exit 0
flock 9 || exit 0

git -C "$DOTFILES" add -A applications
git -C "$DOTFILES" diff --cached --quiet && exit 0

git -C "$DOTFILES" commit -m "sync applications: $(date '+%F %R')"
